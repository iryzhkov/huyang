              ],
              "type": "object"
            }
          },
          "type": "object"
        },
        "transaction_id": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "name": "debug_breakpoints"
  },
