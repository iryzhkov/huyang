  {
    "description": "Inspect threads, stacks, scopes, variables, or explicitly governed evaluation.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "evaluate",
            "scopes",
            "stack",
            "threads",
            "variables"
          ],
          "type": "string"
        },
        "all_frames": {
          "type": "boolean"
        },
        "context": {
          "enum": [
            "repl",
            "watch",
            "hover"
          ],
          "type": "string"
        },
        "depth": {
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "expand": {
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "frame": {
          "minimum": 0,
          "type": "integer"
        },
        "max": {
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "policy": {
          "enum": [
            "read_only",
            "allow_side_effects"
          ],
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "locals",
            "globals",
            "all"
          ],
          "type": "string"
        },
