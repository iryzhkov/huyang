[
  {
    "description": "Open a project or exact documents workspace; return overview, capabilities and preparation commands. Other tools accept root directly.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "files": {
          "items": {
            "description": "Allowlisted document.",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "kind": {
          "description": "Defaults to project when root is given and to documents when only files are.",
          "enum": [
            "project",
            "documents"
          ],
          "type": "string"
        },
        "overview": {
          "enum": [
            "compact",
            "full"
          ],
          "type": "string"
        },
        "root": {
          "description": "Project root; required for kind=project.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "workspace_open"
  },
  {
    "description": "Inspect workspace revision, provider health, coverage and limits.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "root": {
          "description": "Project root; opens or reuses its workspace.",
          "type": "string"
        },
        "view": {
          "enum": [
            "status",
            "overview",
            "map"
          ],
          "type": "string"
        },
        "workspace_id": {
          "description": "Workspace ID; alternatively pass root.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "workspace_inspect"
  },
  {
    "description": "Search text (literal default, regex per line) or ask the language server about a symbol; semantic modes fall back to literal. Scope with paths; context_lines adds context. Refine result sets or search git_history.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "context_lines": {
          "description": "Context lines per hit; at most 20 (larger values reduced to 20 with a warning).",
          "minimum": 0,
          "type": "integer"
        },
        "git_history": {
          "additionalProperties": false,
          "properties": {
            "fields": {
              "items": {
                "enum": [
                  "message",
                  "path",
                  "diff"
                ],
                "type": "string"
              },
              "type": "array"
            },
            "limit": {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            "query": {
              "description": "Literal query over bounded local history.",
              "type": "string"
            },
            "ref": {
              "description": "Local revision or range; defaults to HEAD.",
              "type": "string"
            }
          },
          "required": [
            "query"
          ],
          "type": "object"
        },
        "include_handles": {
          "description": "Add an editable handle and the column to every hit, for edit_apply kind=replace_range.",
          "type": "boolean"
        },
        "limit": {
          "maximum": 200,
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "enum": [
            "literal",
            "regex",
            "references",
            "definition",
            "implementation",
            "type_definition",
            "incoming_calls",
            "outgoing_calls"
          ],
          "type": "string"
        },
        "paths": {
          "description": "Keep only hits under these paths.",
          "items": {
            "description": "Path substring or glob (whole path or base name).",
            "type": "string"
          },
          "type": "array"
        },
        "query": {
          "description": "Text, regular expression, or for the semantic modes a symbol name.",
          "type": "string"
        },
        "refine": {
          "additionalProperties": false,
          "properties": {
            "matched_text": {
              "additionalProperties": false,
              "properties": {
                "literal": {
                  "description": "Additional literal match constraint.",
                  "type": "string"
                },
                "regex": {
                  "description": "Additional regular-expression constraint.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "path": {
              "description": "Additional path substring.",
              "type": "string"
            }
          },
          "type": "object"
        },
        "result_set_handle": {
          "description": "Frozen current-source result set.",
          "type": "string"
        },
        "root": {
          "description": "Project root; opens or reuses its workspace.",
          "type": "string"
        },
        "workspace_id": {
          "description": "Workspace ID; alternatively pass root.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "search"
  },
  {
    "description": "Find declarations by name substring; return read/edit handles. Go and Python resolve natively; other languages use the provider.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "include_source": {
          "type": "boolean"
        },
        "query": {
          "description": "Name path: Name, Parent/Name, Parent.Name, Parent::Name or (*Parent).Name.",
          "type": "string"
        },
        "root": {
          "description": "Project root; opens or reuses its workspace.",
          "type": "string"
        },
        "workspace_id": {
          "description": "Workspace ID; alternatively pass root.",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "name": "symbol_find"
  },
  {
    "description": "Ask the language server for a declaration's definition, references, callers or hover. Supply symbol or target; use search for text.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "relation": {
          "enum": [
            "definition",
            "type_definition",
            "implementation",
            "references",
            "incoming_calls",
            "outgoing_calls",
            "hover"
          ],
          "type": "string"
        },
        "root": {
          "description": "Project root; opens or reuses its workspace.",
          "type": "string"
        },
        "symbol": {
          "description": "Declaration name; resolved to its one declaration so no target is needed.",
          "type": "string"
        },
        "target": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "handle": {
                  "description": "Opaque revision-bound handle.",
                  "type": "string"
                }
              },
              "required": [
                "handle"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "symbol_locator": {
                  "additionalProperties": false,
                  "properties": {
                    "name_path": {
                      "description": "Declaration name path.",
                      "type": "string"
                    },
                    "path": {
                      "description": "File path.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "name_path"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "symbol_locator"
              ],
              "type": "object"
            }
          ],
          "type": "object"
        },
        "workspace_id": {
          "description": "Workspace ID; alternatively pass root.",
          "type": "string"
        }
      },
      "required": [
        "relation"
      ],
      "type": "object"
    },
    "name": "navigate"
  },
  {
    "description": "Read a path, declaration or handle; targets batches reads. Returns revision_id and line count. Window with start_line/end_line; max_lines caps delivery, view=outline lists declarations.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "end_line": {
          "minimum": 1,
          "type": "integer"
        },
        "limit": {
          "description": "history and changes views: number of entries.",
          "minimum": 1,
          "type": "integer"
        },
        "max_lines": {
          "description": "Line cap per target; reports truncation and total lines.",
          "minimum": 1,
          "type": "integer"
        },
        "numbered": {
          "description": "Prefix each line with its number and a tab.",
          "type": "boolean"
        },
        "root": {
          "description": "Project root; opens or reuses its workspace.",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "type": "integer"
        },
        "target": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "handle": {
                  "description": "Opaque revision-bound handle.",
                  "type": "string"
                }
              },
              "required": [
                "handle"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "symbol_locator": {
                  "additionalProperties": false,
                  "properties": {
                    "name_path": {
                      "description": "Declaration name path.",
                      "type": "string"
                    },
                    "path": {
                      "description": "File path.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "name_path"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "symbol_locator"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "description": "Workspace-relative or absolute text file path.",
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "type": "object"
            }
          ],
          "type": "object"
        },
        "targets": {
          "description": "Batch reads; per-target options override call defaults.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "end_line": {
                "minimum": 1,
                "type": "integer"
              },
              "max_lines": {
                "description": "Cap for this target; overrides the call-level max_lines.",
                "minimum": 1,
                "type": "integer"
              },
              "numbered": {
                "description": "Prefix each line with its number; overrides the call-level numbered.",
                "type": "boolean"
              },
              "path": {
                "description": "Workspace-relative file path.",
                "type": "string"
              },
              "start_line": {
                "minimum": 1,
                "type": "integer"
              },
              "symbol_locator": {
                "additionalProperties": false,
                "properties": {
                  "name_path": {
                    "description": "Declaration name path.",
                    "type": "string"
                  },
                  "path": {
                    "description": "File path.",
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "name_path"
                ],
                "type": "object"
              },
              "view": {
                "enum": [
                  "source",
                  "outline"
                ],
                "type": "string"
              }
            },
            "type": "object"
          },
          "maxItems": 32,
          "minItems": 1,
          "type": "array"
        },
        "view": {
          "enum": [
            "source",
            "outline",
            "history",
            "changes"
          ],
          "type": "string"
        },
        "workspace_id": {
          "description": "Workspace ID; alternatively pass root.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "read"
  },
  {
    "description": "Inspect diagnostic evidence, coverage and provenance; full includes finding bodies.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "full": {
          "description": "Return the complete report including finding bodies and per-dimension evidence IDs.",
          "type": "boolean"
        },
        "root": {
          "description": "Project root; opens or reuses its workspace.",
          "type": "string"
        },
        "since": {
          "description": "Optional diagnostic cursor.",
          "type": "string"
        },
        "workspace_id": {
          "description": "Workspace ID; alternatively pass root.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "diagnostics"
  },
  {
    "description": "Apply a guarded edit and return revisions and diagnostics. replace_literal matches old text (expected_count defaults to 1); create_file refuses existing paths unless replace plus revision_id. delete_file needs revision_id or expected_sha256. Handles support replace_range. operations runs sequentially; a refusal keeps earlier edits. Use change_plan for atomic edits. Transfers preserve bytes; stage Git changes separately.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "format": {
          "description": "Format edits (default true); false preserves bytes. Transfers and deletes are never formatted.",
          "type": "boolean"
        },
        "idempotency_key": {
          "description": "Stable retry key; generated if omitted.",
          "type": "string"
        },
        "operation": {
          "additionalProperties": false,
          "properties": {
            "content": {
              "description": "create_file: the file content; replace_range: exact replacement bytes.",
              "type": "string"
            },
            "destination_revision_id": {
              "description": "Optional missing-destination revision.",
              "type": "string"
            },
            "expected_count": {
              "description": "Required match count (default 1); mismatch changes nothing.",
              "minimum": 1,
              "type": "integer"
            },
            "expected_sha256": {
              "description": "Delete guard (alternative to revision_id); optional copy source guard.",
              "type": "string"
            },
            "from": {
              "description": "Source; copy_file also accepts external absolute paths.",
              "type": "string"
            },
            "kind": {
              "enum": [
                "replace_literal",
                "create_file",
                "move_file",
                "copy_file",
                "delete_file",
                "replace_range"
              ],
              "type": "string"
            },
            "new": {
              "description": "replace_literal: replacement text.",
              "type": "string"
            },
            "old": {
              "description": "Exact old text; uniform indentation differences are reported.",
              "type": "string"
            },
            "path": {
              "description": "File path; replace_literal searches the workspace if omitted.",
              "type": "string"
            },
            "replace": {
              "description": "Overwrite only with its current revision_id.",
              "type": "boolean"
            },
            "revision_id": {
              "description": "Read revision; required for overwrite or delete (unless hash).",
              "type": "string"
            },
            "target": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "handle": {
                      "description": "Opaque revision-bound handle.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "handle"
                  ],
                  "type": "object"
                }
              ],
              "type": "object"
            },
            "to": {
              "description": "Missing destination; parents are created.",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "operations": {
          "description": "Sequential edits, excluding replace_range; earlier edits remain on refusal. One formatter pass and receipt.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "content": {
                "type": "string"
              },
              "destination_revision_id": {
                "type": "string"
              },
              "expected_count": {
                "minimum": 1,
                "type": "integer"
              },
              "expected_sha256": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "replace_literal",
                  "create_file",
                  "move_file",
                  "copy_file",
                  "delete_file"
                ],
                "type": "string"
              },
              "new": {
                "type": "string"
              },
              "old": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "replace": {
                "type": "boolean"
              },
              "revision_id": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "preview_only": {
          "description": "Compute the diff without changing canonical bytes.",
          "type": "boolean"
        },
        "root": {
          "description": "Project root; opens or reuses its workspace.",
          "type": "string"
        },
        "verbose": {
          "description": "Add the full change record, hashes and handle resolution to the response.",
          "type": "boolean"
        },
        "workspace_id": {
          "description": "Workspace ID; alternatively pass root.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "edit_apply"
  },
  {
    "description": "Prepare atomic edits in a sandbox, then apply with plan_id, plan_revision and prepared_revision. Trusted preparation runs format, parser, check and test gates. replace_matches uses a search set handle; rename_symbol, inline_symbol, safe_delete_symbol and apply_code_action ask the language server. Required invariants cannot be waived.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "accept_provisional": {
          "description": "With action=apply, commit a PROVISIONAL plan by explicitly accepting its incomplete diagnostic evidence.",
          "type": "boolean"
        },
        "action": {
          "enum": [
            "create",
            "edit",
            "preview",
            "inspect",
            "prepare",
            "apply",
            "discard"
          ],
          "type": "string"
        },
        "edit": {
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "add",
                "update",
                "remove",
                "reorder",
                "replace_all"
              ],
              "type": "string"
            },
            "op_ids": {
              "items": {
                "description": "Operation identifier.",
                "type": "string"
              },
              "type": "array"
            },
            "operations": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "content": {
                    "maxLength": 4194304,
                    "type": "string"
                  },
                  "depends_on": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "destination_revision_id": {
                    "type": "string"
                  },
                  "expected_sha256": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "indentation": {
                    "enum": [
                      "exact",
                      "syntax_anchor",
                      "formatter"
                    ],
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "replace_symbol",
                      "delete_symbol",
                      "insert_before",
                      "insert_after",
                      "replace_range",
                      "create_file",
                      "move_file",
                      "copy_file",
                      "delete_file",
                      "rename_symbol",
                      "safe_delete_symbol",
                      "inline_symbol",
                      "replace_matches",
                      "apply_code_action"
                    ],
                    "type": "string"
                  },
                  "op_id": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "revision_id": {
                    "type": "string"
                  },
                  "target": {
                    "oneOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "handle": {
                            "description": "Opaque revision-bound handle.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "handle"
                        ],
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "symbol_locator": {
                            "additionalProperties": false,
                            "properties": {
                              "name_path": {
                                "description": "Declaration name path.",
                                "type": "string"
                              },
                              "path": {
                                "description": "File path.",
                                "type": "string"
                              }
                            },
                            "required": [
                              "path",
                              "name_path"
                            ],
                            "type": "object"
                          }
                        },
                        "required": [
                          "symbol_locator"
                        ],
                        "type": "object"
                      }
                    ],
                    "type": "object"
                  },
                  "to": {
                    "type": "string"
                  }
                },
                "required": [
                  "op_id",
                  "kind"
                ],
                "type": "object"
              },
              "maxItems": 32,
              "type": "array"
            }
          },
          "required": [
            "mode"
          ],
          "type": "object"
        },
        "idempotency_key": {
          "description": "Stable retry key; generated if omitted.",
          "type": "string"
        },
        "operations": {
          "description": "At most 32 operations; extend with action=edit and edit.mode=add.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "content": {
                "description": "Exact UTF-8 content for the declared operation (maximum 4 MiB).",
                "maxLength": 4194304,
                "type": "string"
              },
              "depends_on": {
                "items": {
                  "description": "Predecessor op_id.",
                  "type": "string"
                },
                "type": "array"
              },
              "destination_revision_id": {
                "description": "Expected destination document revision for move_file and copy_file.",
                "type": "string"
              },
              "expected_sha256": {
                "description": "copy_file: hash the source must have; bound at creation when omitted. The source may be an absolute path outside the workspace.",
                "type": "string"
              },
              "from": {
                "description": "Source path for move_file or copy_file.",
                "type": "string"
              },
              "indentation": {
                "enum": [
                  "exact",
                  "syntax_anchor",
                  "formatter"
                ],
                "type": "string"
              },
              "kind": {
                "enum": [
                  "replace_symbol",
                  "delete_symbol",
                  "insert_before",
                  "insert_after",
                  "replace_range",
                  "create_file",
                  "move_file",
                  "copy_file",
                  "delete_file",
                  "rename_symbol",
                  "safe_delete_symbol",
                  "inline_symbol",
                  "replace_matches",
                  "apply_code_action"
                ],
                "type": "string"
              },
              "op_id": {
                "description": "Stable operation identifier unique within the plan.",
                "type": "string"
              },
              "path": {
                "description": "Workspace path for create_file or delete_file.",
                "type": "string"
              },
              "revision_id": {
                "description": "Expected document revision; create binds missing-target revision if omitted.",
                "type": "string"
              },
              "target": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "handle": {
                        "description": "Opaque revision-bound handle.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "handle"
                    ],
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "symbol_locator": {
                        "additionalProperties": false,
                        "properties": {
                          "name_path": {
                            "description": "Declaration name path.",
                            "type": "string"
                          },
                          "path": {
                            "description": "File path.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "path",
                          "name_path"
                        ],
                        "type": "object"
                      }
                    },
                    "required": [
                      "symbol_locator"
                    ],
                    "type": "object"
                  }
                ],
                "type": "object"
              },
              "to": {
                "description": "Destination path for move_file or copy_file.",
                "type": "string"
              }
            },
            "required": [
              "op_id",
              "kind"
            ],
            "type": "object"
          },
          "maxItems": 32,
          "type": "array"
        },
        "plan_id": {
          "description": "Required after creation unless prepare supplies operations inline.",
          "type": "string"
        },
        "plan_revision": {
          "description": "Required with plan_id.",
          "minimum": 1,
          "type": "integer"
        },
        "prepared_revision": {
          "description": "Required when action=apply.",
          "type": "string"
        },
        "root": {
          "description": "Project root; opens or reuses its workspace.",
          "type": "string"
        },
        "workspace_id": {
          "description": "Workspace ID; alternatively pass root.",
          "type": "string"
        }
