{"jsonrpc":"2.0","id":2,"result":{"content":[{"type":"text","text":"{\"api_version\":\"huyang.workspace/v1alpha1\",\"code\":\"graph_source_changed\",\"data\":{},\"evidence\":null,\"guide\":[\"Name the repository with root on any call; workspace_open is for this overview only.\",\"Change text you know with edit_apply replace_literal: one call, no search first.\",\"Several edits at once: edit_apply operations; change_plan when they must be atomic.\",\"Move, copy and delete files with edit_apply, then run the git command under next.\",\"A file over 500 lines: read view=outline or max_lines before the whole file.\"],\"next\":[],\"outcome\":\"failed\",\"request_id\":\"req_7\",\"summary\":\"graph_source_changed: source changed during execution acquisition\",\"warnings\":[],\"workspace\":{\"id\":\"ws_ad940c7199cf22fa3573011a6a9d23cb\",\"revision\":\"wsrev_1\"}}"}],"structuredContent":{"api_version":"huyang.workspace/v1alpha1","code":"graph_source_changed","data":{},"guide":["Name the repository with root on any call; workspace_open is for this overview only.","Change text you know with edit_apply replace_literal: one call, no search first.","Several edits at once: edit_apply operations; change_plan when they must be atomic.","Move, copy and delete files with edit_apply, then run the git command under next.","A file over 500 lines: read view=outline or max_lines before the whole file."],"next":[],"outcome":"failed","request_id":"req_7","summary":"graph_source_changed: source changed during execution acquisition","warnings":[],"workspace":{"id":"ws_ad940c7199cf22fa3573011a6a9d23cb","revision":"wsrev_1"}},"isError":true}}
